{
  "manifest_version": 3,
  "name": "Svenbot Companion (Alpha)",
  "description": "Analyze the current page with source excerpts and an explicitly paired local Svenbot model.",
  "version": "0.1.4",
  "minimum_chrome_version": "114",
  "permissions": ["activeTab", "scripting", "sidePanel", "storage"],
  "optional_host_permissions": ["http://127.0.0.1/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Open Svenbot Companion"},
  "side_panel": {"default_path": "panel.html"},
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://127.0.0.1:8767"
  }
}
